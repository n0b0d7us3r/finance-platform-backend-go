# Local defaults match Laravel where a default exists.
# APP_ENV=production requires DB_*, REDIS_HOST, REDIS_PORT and CASCADE_PAYMENT_DETAIL_ID to be set.
# Do not put real secrets here.

APP_ENV=local
APP_NAME=laravel
# Stands use Europe/Moscow. Unset means UTC, the Laravel default.
APP_TIMEZONE=Europe/Moscow

# Bind on loopback. Empty falls back to 127.0.0.1:8080.
HTTP_ADDR=127.0.0.1:8080

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CACHE_DB=1
# Separate persistent Redis for conversion prices. Not the token cache.
PRICES_REDIS_HOST=127.0.0.1
PRICES_REDIS_PORT=6379
PRICES_REDIS_DB=0
# Security action history. Same persistent Redis as prices, a different database.
AUDIT_REDIS_DB=2
# Empty uses {slug(APP_NAME)}_cache_, same prefix rule as Laravel CACHE_PREFIX.
CACHE_PREFIX=

# Milliseconds. Laravel default 30000 and 100.
ORDER_POOLING_MAX_WAIT_TIME=30000
ORDER_POOLING_POLL_INTERVAL=100
# Concurrent POST /order waits. Above this the API answers 503 and writes no order.
ORDER_POOLING_MAX_WAITERS=64

FEATURE_CASCADE=false

# Required when APP_ENV=production. Empty is allowed locally.
CASCADE_PAYMENT_DETAIL_ID=

# true keeps the current Laravel Http::withoutVerifying() behaviour.
CALLBACK_INSECURE_SKIP_VERIFY=true

# Required for relay and worker. api and scheduler ignore it.
KAFKA_BROKERS=127.0.0.1:9092

# Access-Token for /api/bot. Empty rejects every bot call. A merchant token never matches.
API_BOT_TOKEN=
# Access-Token for /api/deposit/webhook and /api/withdraw/webhook. Empty rejects every call.
API_DEPOSIT_TOKEN=
API_WITHDRAW_TOKEN=
# Provider that broadcasts a merchant USDT withdrawal. Empty on a local stand accepts the invoice in-process.
WITHDRAWAL_SERVICE_HOST=
# Dispute receipt files. The cabinet opens them at /disputes/{id}/receipt.
RECEIPTS_DIR=/tmp/receipts
